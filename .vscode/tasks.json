{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "pyinstaller main.spec --noconfirm --clean; cp src/config.ini dist/main; cp src/*.csv dist/main"
        },
        {
            "label": "dev build (console)",
            "type": "shell",
            "command": "pyinstaller dev.spec --noconfirm --clean; cp src/config.ini dist/main; cp src/*.csv dist/main"
        }
    ]
}